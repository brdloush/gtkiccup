{:paths ["src" "examples" "scripts"]
 ;; the library's own dep, repeated: bb.edn does not read deps.edn
 :deps {no.cjohansen/replicant {:mvn/version "2026.07.1"}}

 :tasks
 {counter {:doc "Run the counter example (reactive GTK4 window)."
           :task (exec 'counter/-main)}

  todo    {:doc "Run the todo example (dynamic list, entry, check buttons)."
           :task (exec 'todo/-main)}

  ;; -Xmx has to be on the command line, so these re-exec babashka with it.
  ;; bb is a GraalVM native image and honours -Xmx: without it the monitor sits
  ;; around 190 MB resident, with it around 158 MB. The renderer is chosen from
  ;; inside the app, in monitor/lean!.
  monitor {:doc "Run the libadwaita system monitor (the pretty one)."
           :requires ([babashka.process])
           :task (babashka.process/exec "bb" "-Xmx96m" "-m" "monitor")}

  ;; `shot` runs inside a private headless cage, which shot.clj resizes to the
  ;; target's :size at scale 2: a sharp picture of a fixed size, the same on
  ;; any machine, and no window on your desktop. shot-direct is the same app on
  ;; your own display, at its scale.
  shot    {:doc "Write docs/images/<app>.png at scale 2, inside a private headless cage. bb shot [monitor|weather|deck] [path]"
           :requires ([babashka.process])
           :task (apply babashka.process/exec
                        "scripts/headless" "bb" "-Xmx96m" "-m" "shot" *command-line-args*)}

  shot-direct
          {:doc "The same screenshot, on your current display and at its scale. bb shot-direct [monitor|weather|deck] [path]"
           :requires ([babashka.process])
           :task (apply babashka.process/exec
                        "bb" "-Xmx96m" "-m" "shot" *command-line-args*)}

  weather {:doc "Run the Open-Meteo weather app (no API key needed)."
           :requires ([babashka.process])
           :task (babashka.process/exec "bb" "-Xmx96m" "-m" "weather")}

  deck    {:doc "Present a markdown file. bb deck [path.md]"
           :requires ([babashka.process])
           :task (apply babashka.process/exec
                        "bb" "-Xmx96m" "-m" "deck" *command-line-args*)}

  install-desktop
          {:doc "Install .desktop files + icons so the apps look native."
           :requires ([desktop])
           :task (desktop/-main "install")}

  uninstall-desktop
          {:doc "Remove what install-desktop wrote."
           :requires ([desktop])
           :task (desktop/-main "uninstall")}

  dev     {:doc "Start an nREPL server, then connect your editor and see gtkiccup.dev."
           :task (shell "bb" "nrepl-server" "1667")}

  ;; `bb test` runs the suite inside a PRIVATE, windowless headless cage
  ;; (scripts/headless): one fresh compositor per run, so no window maps on
  ;; your desktop and nothing steals focus. tests-direct owns the file list;
  ;; `test` is just it, wrapped. The examples, shot and dev always run on the
  ;; desktop: those windows are meant to be seen.
  test    {:doc "Run all 34 test files against real GTK, inside a private headless cage (no window, no focus steal). For your own display: bb tests-direct."
           :requires ([babashka.process])
           :task (babashka.process/exec "scripts/headless" "bb" "tests-direct")}

  tests-direct
          {:doc "Run the whole suite against the display you are on now. Same files as `bb test`, but each window maps on your desktop."
           :requires ([babashka.process])
           ;; One child per file, and no early exit: :continue keeps the loop
           ;; going, so one broken file does not hide the ones behind it. The
           ;; summary names whatever failed, and the exit code is ours to set.
           :task (let [files ["test/reconcile_test.clj"
                         "test/alias_test.clj"
                         "test/keyed_test.clj"
                         "test/signals_test.clj"
                         "test/repl_reload_test.clj"
                         "test/dev_test.clj"
                         "test/error_recovery_test.clj"
                         "test/text_children_test.clj"
                         "test/splice_test.clj"
                         "test/props_test.clj"
                         "test/memo_test.clj"
                         "test/memo_budget_test.clj"
                         "test/extension_test.clj"
                         "test/adw_test.clj"
                         "test/application_test.clj"
                         "test/scrolled_test.clj"
                         "test/clamp_test.clj"
                         "test/overlay_split_view_test.clj"
                         "test/view_stack_test.clj"
                         "test/view_switcher_test.clj"
                         "test/center_box_test.clj"
                         "test/refs_test.clj"
                         "test/label_props_test.clj"
                         "test/picture_props_test.clj"
                         "test/leaf_widgets_test.clj"
                         "test/sysinfo_test.clj"
                         "test/screenshot_test.clj"
                         "test/openmeteo_test.clj"
                         "test/weather_test.clj"
                         "test/i18n_test.clj"
                         "test/input_test.clj"
                         "test/motion_test.clj"
                         "test/deckmd_test.clj"
                         "test/desktop_test.clj"]]
                   (loop [fs (seq files) bad []]
                     (if-let [f (first fs)]
                       (do (println (str "\n== " f))
                           (let [{:keys [exit]} (deref (babashka.process/shell
                                                        {:continue true} "bb" f))]
                             (recur (next fs) (if (zero? exit) bad (conj bad f)))))
                       (if (empty? bad)
                         (println (str "SUITE OK files=" (count files)))
                         (do (println (str "SUITE FAILED " (count bad) " of "
                                           (count files) " -- " (pr-str bad)))
                             (System/exit 1))))))}}}
