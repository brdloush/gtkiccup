{:paths ["src" "examples" "scripts"]
 ;; the library's own dep, repeated: bb.edn does not read deps.edn
 :deps {no.cjohansen/replicant {:mvn/version "2026.07.1"}}

 :tasks
 {counter {:doc "Run the counter example (reactive GTK4 window)."
           :task (exec 'counter/-main)}

  todo    {:doc "Run the todo example (dynamic list, entry, check buttons)."
           :task (exec 'todo/-main)}

  ;; -Xmx has to be on the command line, so these re-exec babashka with it.
  ;; bb is a GraalVM native image and honours -Xmx: without it the monitor sits
  ;; around 190 MB resident, with it around 158 MB. The renderer is chosen from
  ;; inside the app, in monitor/lean!.
  monitor {:doc "Run the libadwaita system monitor (the pretty one)."
           :requires ([babashka.process])
           :task (babashka.process/exec "bb" "-Xmx96m" "-m" "monitor")}

  shot    {:doc "Write docs/images/<app>.png -- the app screenshots itself. bb shot [monitor|weather|deck]"
           :requires ([babashka.process])
           :task (apply babashka.process/exec
                        "bb" "-Xmx96m" "-m" "shot" *command-line-args*)}

  weather {:doc "Run the Open-Meteo weather app (no API key needed)."
           :requires ([babashka.process])
           :task (babashka.process/exec "bb" "-Xmx96m" "-m" "weather")}

  deck    {:doc "Present a markdown file. bb deck [path.md]"
           :requires ([babashka.process])
           :task (apply babashka.process/exec
                        "bb" "-Xmx96m" "-m" "deck" *command-line-args*)}

  install-desktop
          {:doc "Install .desktop files + icons so the apps look native."
           :requires ([desktop])
           :task (desktop/-main "install")}

  uninstall-desktop
          {:doc "Remove what install-desktop wrote."
           :requires ([desktop])
           :task (desktop/-main "uninstall")}

  ;; The compositor `bb test` runs in. `bb cage` once per login, move its
  ;; single window to a spare workspace, and test runs stop touching your
  ;; desktop. Starting it maps one host window and takes focus once -- that is
  ;; the whole point versus wrapping each run in `cage -- bb test`.
  cage        {:doc "Start the persistent cage compositor (one host window; park it on a spare workspace)."
               :task (shell "scripts/cage-server" "start")}

  cage-stop   {:doc "Stop the persistent cage compositor."
               :task (shell "scripts/cage-server" "stop")}

  cage-status {:doc "Report whether cage is running and on which socket."
               :task (shell "scripts/cage-server" "status")}

  dev     {:doc "Start an nREPL server, then connect your editor and see gtkiccup.dev."
           :task (shell "bb" "nrepl-server" "1667")}

  ;; The one task that runs inside cage by default: a test run opens and closes
  ;; dozens of windows, and each would take focus on the desktop. The first call
  ;; starts cage if it is not up, then re-runs this task inside it, where every
  ;; window is a child surface. GTKICCUP_NO_CAGE=1 runs it on the desktop
  ;; instead, for debugging. The examples, shot and dev always run on the
  ;; desktop: those windows are meant to be seen.
  test    {:doc "Run all 32 test files against real GTK, inside the persistent cage."
           :requires ([cage :as cage])
           :task (if (cage/here?)
                   (doseq [f ["test/reconcile_test.clj"
                            "test/keyed_test.clj"
                            "test/signals_test.clj"
                            "test/repl_reload_test.clj"
                            "test/dev_test.clj"
                            "test/error_recovery_test.clj"
                            "test/text_children_test.clj"
                            "test/splice_test.clj"
                            "test/props_test.clj"
                            "test/memo_test.clj"
                            "test/extension_test.clj"
                            "test/adw_test.clj"
                            "test/application_test.clj"
                            "test/scrolled_test.clj"
                            "test/clamp_test.clj"
                            "test/overlay_split_view_test.clj"
                            "test/view_stack_test.clj"
                            "test/view_switcher_test.clj"
                            "test/center_box_test.clj"
                            "test/refs_test.clj"
                            "test/label_props_test.clj"
                            "test/picture_props_test.clj"
                            "test/leaf_widgets_test.clj"
                            "test/sysinfo_test.clj"
                            "test/screenshot_test.clj"
                            "test/openmeteo_test.clj"
                            "test/weather_test.clj"
                            "test/i18n_test.clj"
                            "test/input_test.clj"
                            "test/motion_test.clj"
                            "test/deckmd_test.clj"
                            "test/desktop_test.clj"]]
                   (println (str "\n== " f))
                   (shell "bb" f))
                   (cage/rerun "test"))}}}
