#!/usr/bin/env bash
# Persistent nested Wayland compositor (cage) for gtkiccup UI runs.
#
# Why: gtkiccup's tests and examples open real toplevels, and on a live
# GNOME/mutter session the compositor decides focus the moment one maps. A
# wrapper like `cage -- bb test` therefore maps a new host window and steals
# focus on every single run. This keeps ONE long-lived cage with a stable
# Wayland socket, and every test / shot / example attaches to it as a *client*.
# Inner toplevels then live inside cage's own toplevel, so mutter never sees a
# new window and your focus stays where you put it.
#
# Intended flow: `bb cage` once per login, then move that single window to a
# spare workspace (Ctrl+Alt+Shift+Page Up on GNOME). After that every UI run is
# invisible on your desktop.
#
# Trade-offs, verified on this box:
#   * Starting cage maps one host window and grabs focus once. Unavoidable with
#     the wlroots Wayland backend; the DRM backend needs DRM master, which
#     GNOME holds, and `WLR_BACKENDS=drm cage` fails "Device or resource busy".
#   * The pid file is shared with babatidal's scripts/cage-server on purpose,
#     so the two repos drive one compositor instead of fighting over two.
#   * GTK falls back to the X server when DISPLAY survives, so `run` and
#     `start` clear DISPLAY as well as pointing WAYLAND_DISPLAY at cage.

set -euo pipefail
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
PID_FILE="/tmp/cage-server.pid"
LOG_FILE="/tmp/cage-server.log"
IDLE_CMD="${GTKICCUP_CAGE_IDLE_CMD:-sleep 86400}"

_alive() { [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; }

# newest non-host, non-.lock wayland socket -- cage appends N; the host is
# wayland-0, and picking the highest N avoids a dead socket from an old run.
_socket() {
  local s out=""
  for s in "$RUN_DIR"/wayland-*; do
    [ -S "$s" ] || continue
    [ "$s" = "$RUN_DIR/wayland-0" ] && continue
    out="$s"
  done
  if [ -n "$out" ]; then basename "$out"; fi
}

start() {
  if _alive; then
    echo "cage-server already running: pid=$(cat "$PID_FILE") socket=$(_socket)"
    return 0
  fi
  # Purge sockets/locks left behind by a SIGKILLed cage, or the client's
  # WAYLAND_DISPLAY can point at a dead socket ("Failed to open display").
  # Never touch the host's wayland-0.
  local f
  for f in "$RUN_DIR"/wayland-*.lock; do
    [ "$f" = "$RUN_DIR/wayland-0.lock" ] && continue
    rm -f "$f"
  done
  for f in "$RUN_DIR"/wayland-*; do
    case "$f" in *.lock) continue;; esac
    [ "$f" = "$RUN_DIR/wayland-0" ] && continue
    [ -S "$f" ] && rm -f "$f"
  done
  # Unquoted on purpose: $IDLE_CMD is a command, so "sleep 86400" has to split
  # into two argv entries. Quoting it makes cage exec a file literally named
  # "sleep 86400" and it dies with "Failed to spawn client: No such file or
  # directory".
  nohup env -u DISPLAY cage -- $IDLE_CMD >"$LOG_FILE" 2>&1 &
  local cage_pid=$!
  echo "$cage_pid" > "$PID_FILE"
  for _ in $(seq 1 50); do
    sleep 0.2
    local s; s="$(_socket)"
    if [ -n "$s" ] && [ "$s" != wayland-0 ]; then
      echo "cage-server started: pid=$cage_pid socket=$s"
      echo "Tip: move this one window to a spare workspace (Ctrl+Alt+Shift+Page Up),"
      echo "     then UI runs never touch your active desktop."
      return 0
    fi
  done
  echo "cage-server did not expose a socket within 10s; see $LOG_FILE" >&2
  # The usual cause is not cage: a nested compositor can only connect while the
  # host session accepts nested clients. If the log says "Could not connect to
  # remote display: Connection refused" then the session's Wayland listener is
  # not accepting them -- after a SIGKILLed cage, GNOME needs a logout/login (or
  # a gnome-shell restart) before another nested compositor can attach.
  grep -q "Could not connect to remote display" "$LOG_FILE" 2>/dev/null &&
    echo "hint: the host compositor refused the nested connection. A cage killed with SIGKILL can leave GNOME's nested-client slot wedged; log out and in, or restart gnome-shell." >&2
  kill "$cage_pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  return 1
}

stop() {
  if _alive; then
    local s; s="$(_socket)"
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    # cage leaves its socket behind when killed; remove it so the next client
    # cannot bind to a dead one.
    rm -f "$RUN_DIR/$s" "$RUN_DIR/$s.lock" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "cage-server stopped"
  else
    echo "cage-server not running"
  fi
}

# eval "$(scripts/cage-server env)" -- for driving UI work by hand.
show-env() {
  if _alive; then
    echo "export WAYLAND_DISPLAY=$(_socket)"
    echo "export GDK_BACKEND=wayland"
    echo "export DISPLAY="
    echo "export GTKICCUP_CAGE=1"
  else
    echo "cage-server not running: run 'bb cage' first" >&2
    return 1
  fi
}

# run <cmd...> -- attach to the persistent cage, starting it if needed. No new
# cage window is created per run. GTKICCUP_CAGE lets a task started this way
# tell that it is already inside, which is what stops bb.edn recursing.
run() {
  if ! _alive; then start; fi
  local s; s="$(_socket)"
  [ -n "$s" ] || { echo "no cage socket, see $LOG_FILE" >&2; return 1; }
  env -u DISPLAY -u GDK_BACKEND \
      WAYLAND_DISPLAY="$s" GDK_BACKEND=wayland GTKICCUP_CAGE=1 \
      "$@"
}

case "${1:-status}" in
  start)  start;;
  stop)   stop;;
  status) if _alive; then echo "running pid=$(cat "$PID_FILE") socket=$(_socket)"; else echo "stopped"; fi;;
  env|show-env) show-env;;
  run)    shift; run "$@";;
  *) echo "usage: $0 {start|stop|status|env|run <cmd...>}" >&2; exit 2;;
esac
